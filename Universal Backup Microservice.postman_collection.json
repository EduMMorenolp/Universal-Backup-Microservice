		},
		{
			"name": "Características Avanzadas",
			"item": [
				{
					"name": "Programar Backup Automático",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"daily-backup\",\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"my_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  },\n  \"schedule\": \"0 2 * * *\",\n  \"retention\": 30,\n  \"options\": {\n    \"chunkSize\": 300,\n    \"format\": \"seeders\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/advanced/schedule",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "advanced", "schedule"]
						},
						"description": "Programa backup automático con cron (0 2 * * * = 2 AM diario)"
					},
					"response": []
				},
				{
					"name": "Listar Backups Programados",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/advanced/schedules",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "advanced", "schedules"]
						}
					},
					"response": []
				},
				{
					"name": "Cancelar Backup Programado",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/advanced/schedule/daily-backup",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "advanced", "schedule", "daily-backup"]
						}
					},
					"response": []
				},
				{
					"name": "Comparar Dos Backups",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbName\": \"my_database\",\n  \"backupId1\": \"backup-20250128-143022\",\n  \"backupId2\": \"backup-20250129-143022\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/advanced/compare",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "advanced", "compare"]
						},
						"description": "Compara dos backups y retorna diferencias"
					},
					"response": []
				},
				{
					"name": "Subir Backup a S3",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbName\": \"my_database\",\n  \"backupId\": \"backup-20250128-143022\",\n  \"s3Config\": {\n    \"bucket\": \"my-backups\",\n    \"region\": \"us-east-1\",\n    \"accessKeyId\": \"YOUR_ACCESS_KEY\",\n    \"secretAccessKey\": \"YOUR_SECRET_KEY\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/advanced/upload-s3",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "advanced", "upload-s3"]
						},
						"description": "Comprime y sube backup a AWS S3"
					},
					"response": []
				},
				{
					"name": "Obtener Métricas",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/advanced/metrics",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "advanced", "metrics"]
						},
						"description": "Métricas completas: total backups, espacio usado, estadísticas"
					},
					"response": []
				}
			]
		}
