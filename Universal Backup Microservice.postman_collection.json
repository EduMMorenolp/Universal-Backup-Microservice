						},
						"description": "Información del servicio y endpoints disponibles"
					},
					"response": []
				}
			]
		},
		{
			"name": "Análisis de Base de Datos",
			"item": [
				{
					"name": "Analizar Base de Datos",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/analyze",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "analyze"]
						},
						"description": "Analiza la estructura de cualquier base de datos Sequelize"
					},
					"response": []
				}
			]
		},
		{
			"name": "Extracción de Backups",
			"item": [
				{
					"name": "Extraer Backup Completo (Full)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  },\n  \"options\": {\n    \"chunkSize\": 300,\n    \"format\": \"seeders\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/extract",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "extract"]
						},
						"description": "Extrae backup completo con todos los datos"
					},
					"response": []
				},
				{
					"name": "Extraer Backup Incremental",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  },\n  \"options\": {\n    \"incremental\": true,\n    \"basedOn\": \"backup-20250128-143022\",\n    \"chunkSize\": 300,\n    \"format\": \"seeders\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/extract",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "extract"]
						},
						"description": "Extrae solo cambios desde el último backup (nuevos y modificados)"
					},
					"response": []
				}
			]
		},
		{
			"name": "Gestión de Backups",
			"item": [
				{
					"name": "Listar Backups",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/backup/list",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "list"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Restore de Backups",
			"item": [
				{
					"name": "Obtener Info de Backup",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"database\": \"my_database\",\n  \"backupId\": \"backup-20250128-143022\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/restore/info",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "restore", "info"]
						},
						"description": "Obtiene información detallada de un backup antes de restaurar"
					},
					"response": []
				},
				{
					"name": "Validar BD Destino",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"targetDbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"target_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/restore/validate",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "restore", "validate"]
						},
						"description": "Valida si la BD destino está vacía o tiene datos"
					},
					"response": []
				},
				{
					"name": "Limpiar BD Destino",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"targetDbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"target_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/restore/clean",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "restore", "clean"]
						},
						"description": "Limpia todas las tablas de la BD destino (TRUNCATE CASCADE)"
					},
					"response": []
				},
				{
					"name": "Restaurar Backup (BD Vacía)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"database\": \"my_database\",\n  \"backupId\": \"backup-20250128-143022\",\n  \"targetDbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"target_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/restore",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "restore"]
						},
						"description": "Restaura backup en BD vacía. Falla si la BD tiene datos."
					},
					"response": []
				},
				{
					"name": "Restaurar Backup (Force)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"database\": \"my_database\",\n  \"backupId\": \"backup-20250128-143022\",\n  \"targetDbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"target_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\"\n  },\n  \"options\": {\n    \"force\": true\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/restore",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "restore"]
						},
						"description": "Restaura backup con force: true. Limpia BD destino automáticamente."
					},
					"response": []
				}
			]
		},
