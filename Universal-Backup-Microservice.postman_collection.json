{
	"info": {
		"_postman_id": "backup-microservice-001",
		"name": "Universal Backup Microservice",
		"description": "Microservicio universal de backup y análisis de bases de datos Sequelize para cualquier proyecto",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "universal-backup"
	},
	"item": [
		{
			"name": "Health & Info",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/health",
							"host": ["{{BASE_URL}}"],
							"path": ["health"]
						},
						"description": "Verifica el estado del microservicio"
					},
					"response": []
				},
				{
					"name": "Service Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/",
							"host": ["{{BASE_URL}}"]
						},
						"description": "Información del servicio y endpoints disponibles"
					},
					"response": []
				}
			]
		},
		{
			"name": "Análisis de Base de Datos",
			"item": [
				{
					"name": "Analizar Base de Datos 1",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/analyze",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "analyze"]
						},
						"description": "Analiza la estructura de cualquier base de datos Sequelize:\n- Detecta todos los modelos\n- Identifica dependencias\n- Genera orden de extracción\n- Crea timestamps automáticos\n- Retorna entitiesOrder completo"
					},
					"response": []
				},
				{
					"name": "Analizar Base de Datos 2",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"another_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/analyze",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "analyze"]
						},
						"description": "Analiza otra base de datos diferente"
					},
					"response": []
				},
				{
					"name": "Analizar Base de Datos Custom",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"your_database\",\n    \"username\": \"postgres\",\n    \"password\": \"your_password\",\n    \"dialect\": \"postgres\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/analyze",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "analyze"]
						},
						"description": "Analiza cualquier base de datos Sequelize personalizada"
					},
					"response": []
				}
			]
		},
		{
			"name": "Extracción de Backups",
			"item": [
				{
					"name": "Extraer Backup (Formato Seeders)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  },\n  \"options\": {\n    \"chunkSize\": 300,\n    \"format\": \"seeders\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/extract",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "extract"]
						},
						"description": "Extrae todos los datos de la base de datos y genera seeders:\n- Analiza estructura automáticamente\n- Resuelve dependencias\n- Fragmenta en chunks de 300 registros\n- Genera seeders con down seguro\n- Crea metadata del backup"
					},
					"response": []
				},
				{
					"name": "Extraer Backup (Formato JSON)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  },\n  \"options\": {\n    \"chunkSize\": 500,\n    \"format\": \"json\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/extract",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "extract"]
						},
						"description": "Extrae datos en formato JSON para análisis o migración"
					},
					"response": []
				},
				{
					"name": "Extraer Otra Base de Datos",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"another_database\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  },\n  \"options\": {\n    \"chunkSize\": 300,\n    \"format\": \"seeders\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/extract",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "extract"]
						},
						"description": "Extrae backup de otra base de datos diferente"
					},
					"response": []
				},
				{
					"name": "Extraer con Chunks Grandes",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dbConfig\": {\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"database_name\",\n    \"username\": \"postgres\",\n    \"password\": \"password\",\n    \"dialect\": \"postgres\"\n  },\n  \"options\": {\n    \"chunkSize\": 1000,\n    \"format\": \"seeders\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/backup/extract",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "extract"]
						},
						"description": "Extrae con fragmentación de 1000 registros por archivo"
					},
					"response": []
				}
			]
		},
		{
			"name": "Gestión de Backups",
			"item": [
				{
					"name": "Listar Todos los Backups",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/backup/list",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "backup", "list"]
						},
						"description": "Lista todos los backups disponibles organizados por base de datos:\n- Agrupados por nombre de BD\n- ID del backup\n- Timestamp de creación\n- Cantidad de registros\n- Cantidad de archivos generados"
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
			"value": "http://localhost:4000",
			"type": "string"
		}
	]
}
